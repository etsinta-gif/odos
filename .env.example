APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PYTHONUNBUFFERED=1
ODOS_ENABLE_STARTUP_CREATE_ALL=0
ODOS_ENABLE_BUSINESS_SCHEMA_FAILFAST=1

# Required when APP_ENV is production or staging.
POSTGRES_USER=odos
POSTGRES_PASSWORD=replace-with-a-secret
POSTGRES_DB=odos
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://odos:replace-with-a-secret@db:5432/odos
REDIS_URL=redis://redis:6379/0
CORS_ALLOW_ORIGINS=https://your-frontend.example.com
IMAGE_NAMESPACE=your-github-owner
VERSION=latest

# Streamlit Cloud secret/environment variable. Use the deployed frontend URL,
# never localhost or 127.0.0.1.
ODOS_FRONTEND_URL=https://your-frontend.example.com
